{
  "dashboard": {
    "title": "redRover — Facility Health Monitor",
    "uid": "redrover-main",
    "tags": ["redrover", "predictive-maintenance"],
    "timezone": "browser",
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 11,
        "title": "",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "collapsed": false,
        "panels": []
      },
      {
        "id": 12,
        "title": "Room Map",
        "type": "text",
        "gridPos": { "h": 16, "w": 14, "x": 0, "y": 1 },
        "options": {
          "mode": "html",
          "content": "<div style=\"text-align:center; background:#1a1a2e; padding:10px; border-radius:8px;\">\n  <img src=\"http://localhost:8080/api/map/image\" style=\"max-width:100%; max-height:550px; border-radius:4px; border:1px solid #333;\" onerror=\"this.style.display='none'; document.getElementById('no-map-msg').style.display='block';\" />\n  <div id=\"no-map-msg\" style=\"display:none; color:#aaa; padding:40px; font-size:16px;\">No room map available.<br/>Click <b>Start Mapping</b> to create one.</div>\n</div>"
        }
      },
      {
        "id": 13,
        "title": "Mapping Controls",
        "type": "text",
        "gridPos": { "h": 6, "w": 10, "x": 14, "y": 1 },
        "options": {
          "mode": "html",
          "content": "<div style=\"padding:15px; font-family:sans-serif;\">\n  <h3 style=\"color:#e0e0e0; margin-top:0;\">Room Mapping</h3>\n  <div style=\"margin-bottom:12px;\">\n    <label style=\"color:#aaa; font-size:12px;\">Speed (0-255):</label>\n    <input id=\"map-speed\" type=\"number\" value=\"50\" min=\"20\" max=\"150\" style=\"width:60px; background:#222; color:#fff; border:1px solid #555; padding:4px; border-radius:3px; margin-left:5px;\" />\n    <label style=\"color:#aaa; font-size:12px; margin-left:10px;\">Duration (s):</label>\n    <input id=\"map-duration\" type=\"number\" value=\"60\" min=\"10\" max=\"300\" style=\"width:60px; background:#222; color:#fff; border:1px solid #555; padding:4px; border-radius:3px; margin-left:5px;\" />\n    <label style=\"color:#aaa; font-size:12px; margin-left:10px;\">Bounds (m):</label>\n    <input id=\"map-bounds\" type=\"number\" value=\"3.0\" min=\"1\" max=\"10\" step=\"0.5\" style=\"width:60px; background:#222; color:#fff; border:1px solid #555; padding:4px; border-radius:3px; margin-left:5px;\" />\n  </div>\n  <div style=\"display:flex; gap:10px;\">\n    <button onclick=\"startMapping()\" id=\"btn-start\" style=\"padding:8px 20px; background:#2ecc71; color:#fff; border:none; border-radius:5px; cursor:pointer; font-size:14px; font-weight:bold;\">Start Mapping</button>\n    <button onclick=\"startMapping(true)\" style=\"padding:8px 20px; background:#3498db; color:#fff; border:none; border-radius:5px; cursor:pointer; font-size:14px;\">Simulate</button>\n    <button onclick=\"stopMapping()\" id=\"btn-stop\" style=\"padding:8px 20px; background:#e74c3c; color:#fff; border:none; border-radius:5px; cursor:pointer; font-size:14px;\">Stop</button>\n  </div>\n  <div id=\"map-status\" style=\"margin-top:10px; color:#aaa; font-size:13px;\"></div>\n</div>\n<script>\nfunction startMapping(sim) {\n  var speed = document.getElementById('map-speed').value;\n  var dur = document.getElementById('map-duration').value;\n  var bounds = document.getElementById('map-bounds').value;\n  var url = 'http://localhost:8080/api/remap?speed=' + speed + '&duration=' + dur + '&room_bounds=' + bounds;\n  if (sim) url += '&simulate=true';\n  document.getElementById('map-status').innerText = 'Starting mapping...';\n  fetch(url, {method:'POST'}).then(r=>r.json()).then(d=>{\n    document.getElementById('map-status').innerText = 'Status: ' + d.status;\n    if(d.status==='started') pollStatus();\n  }).catch(e=>{\n    document.getElementById('map-status').innerText = 'Error: ' + e;\n  });\n}\nfunction stopMapping() {\n  fetch('http://localhost:8080/api/remap/stop', {method:'POST'}).then(r=>r.json()).then(d=>{\n    document.getElementById('map-status').innerText = 'Status: ' + d.status;\n  });\n}\nfunction pollStatus() {\n  var iv = setInterval(function(){\n    fetch('http://localhost:8080/api/map/stats').then(r=>r.json()).then(d=>{\n      var s = d.mapping_status || d.status;\n      document.getElementById('map-status').innerHTML = 'Status: <b>' + s + '</b>';\n      if(s==='complete' || s==='error' || s==='idle') {\n        clearInterval(iv);\n        if(s==='complete') {\n          document.getElementById('map-status').innerHTML += ' — ' + d.free + ' free, ' + d.wall + ' wall cells, ' + (d.coverage_pct||0).toFixed(1) + '% coverage';\n          var img = document.querySelector('img[src*=\"map/image\"]');\n          if(img) img.src = 'http://localhost:8080/api/map/image?t=' + Date.now();\n        }\n        if(s==='error') document.getElementById('map-status').innerHTML += ' — ' + (d.last_error||'');\n      }\n    });\n  }, 3000);\n}\n</script>"
        }
      },
      {
        "id": 14,
        "title": "Map Coverage",
        "type": "stat",
        "gridPos": { "h": 5, "w": 5, "x": 14, "y": 7 },
        "targets": [
          {
            "expr": "redrover_map_coverage_pct",
            "legendFormat": "Coverage"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 10, "color": "yellow" },
                { "value": 50, "color": "green" }
              ]
            }
          }
        }
      },
      {
        "id": 15,
        "title": "Free Cells",
        "type": "stat",
        "gridPos": { "h": 5, "w": 5, "x": 19, "y": 7 },
        "targets": [
          {
            "expr": "redrover_map_free_cells",
            "legendFormat": "Free"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "value": 0, "color": "blue" },
                { "value": 100, "color": "green" }
              ]
            }
          }
        }
      },
      {
        "id": 16,
        "title": "Wall Cells",
        "type": "stat",
        "gridPos": { "h": 5, "w": 5, "x": 14, "y": 12 },
        "targets": [
          {
            "expr": "redrover_map_wall_cells",
            "legendFormat": "Walls"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 1, "color": "orange" }
              ]
            }
          }
        }
      },
      {
        "id": 17,
        "title": "Area Explored (m²)",
        "type": "stat",
        "gridPos": { "h": 5, "w": 5, "x": 19, "y": 12 },
        "targets": [
          {
            "expr": "redrover_map_area_explored_m2",
            "legendFormat": "Area"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "m2",
            "thresholds": {
              "steps": [
                { "value": 0, "color": "blue" },
                { "value": 1, "color": "green" }
              ]
            }
          }
        }
      },
      {
        "id": 18,
        "title": "",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
        "collapsed": false,
        "panels": []
      },
      {
        "id": 1,
        "title": "Patrol Duration",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
        "targets": [
          {
            "expr": "rate(redrover_patrol_duration_seconds_sum[5m]) / rate(redrover_patrol_duration_seconds_count[5m])",
            "legendFormat": "Avg Patrol Duration (s)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 2,
        "title": "Faults Detected",
        "type": "stat",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 18 },
        "targets": [
          {
            "expr": "increase(redrover_patrol_faults_detected_total[1h])",
            "legendFormat": "Faults (1h)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 2, "color": "yellow" },
                { "value": 5, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Sensor Failures",
        "type": "stat",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 18 },
        "targets": [
          {
            "expr": "increase(redrover_sensor_failures_total[1h])",
            "legendFormat": "{{sensor_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 1, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "AI Inference Mode",
        "type": "piechart",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 26 },
        "targets": [
          {
            "expr": "increase(redrover_ai_inference_count_total[1h])",
            "legendFormat": "{{inference_mode}}"
          }
        ]
      },
      {
        "id": 5,
        "title": "AI Inference Duration",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 26 },
        "targets": [
          {
            "expr": "rate(redrover_ai_inference_seconds_sum[5m]) / rate(redrover_ai_inference_seconds_count[5m])",
            "legendFormat": "Avg Inference (s)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 6,
        "title": "AI Confidence Distribution",
        "type": "histogram",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 26 },
        "targets": [
          {
            "expr": "redrover_ai_confidence_bucket",
            "legendFormat": "{{le}}"
          }
        ]
      },
      {
        "id": 7,
        "title": "Station Measurement Duration",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
        "targets": [
          {
            "expr": "rate(redrover_station_measurement_seconds_sum[5m]) / rate(redrover_station_measurement_seconds_count[5m])",
            "legendFormat": "{{station_id}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 8,
        "title": "Database Query Duration",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
        "targets": [
          {
            "expr": "rate(redrover_db_query_seconds_sum[5m]) / rate(redrover_db_query_seconds_count[5m])",
            "legendFormat": "{{db_operation}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 9,
        "title": "Faults by Type",
        "type": "barchart",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
        "targets": [
          {
            "expr": "increase(redrover_ai_faults_detected_total[1h])",
            "legendFormat": "{{fault_type}}"
          }
        ]
      },
      {
        "id": 10,
        "title": "DB Queries per Minute",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
        "targets": [
          {
            "expr": "rate(redrover_db_query_count_total[1m]) * 60",
            "legendFormat": "{{db_operation}}"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
